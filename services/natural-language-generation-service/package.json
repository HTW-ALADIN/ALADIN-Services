{
	"name": "natural-language-generation-service",
	"version": "0.1.0",
	"description": "Deterministic surface realisation and trusted template-based NLG over REST and CLI.",
	"private": true,
	"type": "module",
	"bin": {
		"nlg": "./dist/src/cli/index.js"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/src/api/index.js",
		"start:dev": "node --import tsx src/api/index.ts",
		"cli": "node --import tsx src/cli/index.ts",
		"test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
		"test:coverage": "c8 node --import tsx --test --test-concurrency=1 test/*.test.ts",
		"lint": "eslint src test scripts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:openapi": "node --import tsx scripts/generate-openapi.ts"
	},
	"dependencies": {
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.0",
		"@sinclair/typebox": "^0.34.52",
		"commander": "^14.0.0",
		"fastify": "^5.10.0",
		"jsrealb": "5.5.0",
		"rosaenlg": "4.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@types/chai": "^5.0.1",
		"@types/node": "^22.0.0",
		"c8": "^10.1.3",
		"chai": "^5.1.2",
		"eslint": "^9.15.0",
		"globals": "^15.12.0",
		"prettier": "^3.4.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.16.0"
	},
	"engines": {
		"node": ">=22"
	}
}
