			"SurfaceRealizationRequest": {
				"additionalProperties": false,
				"description": "JSON-only structured realisation request. JavaScript source expressions are never accepted.",
				"type": "object",
				"required": ["mode", "backend", "language", "input"],
				"properties": {
					"mode": { "type": "string", "enum": ["surface_realization"] },
					"backend": { "type": "string", "enum": ["jsrealb"] },
					"language": {
						"anyOf": [
							{ "type": "string", "enum": ["en"] },
							{ "type": "string", "enum": ["fr"] }
						]
					},
					"input": {
						"anyOf": [
							{
								"additionalProperties": false,
								"type": "object",
								"required": ["representation", "structure"],
								"properties": {
									"representation": {
										"type": "string",
										"enum": ["constituent"]
									},
									"structure": {
										"$ref": "#/components/schemas/ConstituentNode"
									}
								}
							},
							{
								"additionalProperties": false,
								"type": "object",
								"required": ["representation", "structure"],
								"properties": {
									"representation": {
										"type": "string",
										"enum": ["dependency"]
									},
									"structure": { "$ref": "#/components/schemas/DependentNode" }
								}
							}
						]
					}
				}
			},
			"TemplateGenerationRequest": {
				"additionalProperties": false,
				"description": "Template/data-to-text request executed by the legacy RosaeNLG backend. Template source is executable and must be trusted.",
				"type": "object",
				"required": ["mode", "backend", "language", "input"],
				"properties": {
					"mode": { "type": "string", "enum": ["template_generation"] },
					"backend": { "type": "string", "enum": ["rosaenlg"] },
					"language": {
						"anyOf": [
							{ "type": "string", "enum": ["en_US"] },
							{ "type": "string", "enum": ["fr_FR"] },
							{ "type": "string", "enum": ["de_DE"] },
							{ "type": "string", "enum": ["it_IT"] },
							{ "type": "string", "enum": ["es_ES"] }
						]
					},
					"input": {
						"additionalProperties": false,
						"description": "Trusted RosaeNLG/Pug template source, JSON data locals, and an optional deterministic random seed.",
						"type": "object",
						"required": ["template", "data"],
						"properties": {
							"template": {
								"minLength": 1,
								"maxLength": 65536,
								"type": "string"
							},
							"data": {
								"maxProperties": 256,
								"type": "object",
								"additionalProperties": {
									"$ref": "#/components/schemas/JsonValue"
								}
							},
							"seed": {
								"minimum": 0,
								"maximum": 4294967295,
								"default": 0,
								"type": "integer"
							}
						}
					}
				}
			},
			"SurfaceRealizationResponse": {
				"additionalProperties": false,
				"type": "object",
				"required": ["text", "mode", "backend", "language", "metadata"],
				"properties": {
					"text": { "type": "string" },
					"mode": { "type": "string", "enum": ["surface_realization"] },
					"backend": { "type": "string", "enum": ["jsrealb"] },
