						}
					}
				}
			},
			"TemplateGenerationResponse": {
				"additionalProperties": false,
				"type": "object",
				"required": ["text", "mode", "backend", "language", "metadata"],
				"properties": {
					"text": { "type": "string" },
					"mode": { "type": "string", "enum": ["template_generation"] },
					"backend": { "type": "string", "enum": ["rosaenlg"] },
					"language": {
						"anyOf": [
							{ "type": "string", "enum": ["en_US"] },
							{ "type": "string", "enum": ["fr_FR"] },
							{ "type": "string", "enum": ["de_DE"] },
							{ "type": "string", "enum": ["it_IT"] },
							{ "type": "string", "enum": ["es_ES"] }
						]
					},
					"metadata": {
						"additionalProperties": false,
						"type": "object",
						"required": ["engineVersion", "seed"],
						"properties": {
							"engineVersion": { "type": "string" },
							"seed": { "minimum": 0, "maximum": 4294967295, "type": "integer" }
						}
					}
				}
			}
		}
