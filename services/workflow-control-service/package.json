{
  "name": "workflow-control-service",
  "version": "0.1.0",
  "private": true,
  "description": "Official Aladin workflow control image: branch/forEach stack operations and ordered result collection",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.mjs\" && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node build/server.js",
    "cli": "node build/cli.js",
    "generate:openapi": "npm run build && node build/generate-openapi.js",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0"
  }
}
