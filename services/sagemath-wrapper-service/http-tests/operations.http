### SageMath Wrapper — SAT, Optimization & Maxima REST API tests
#
# Prerequisites:
#   1. Start the service:  make docker-run  (or  sage -python -m uvicorn src.api.main:app --port 8000)
#   2. These .http files work with VS Code's "REST Client" extension.
#      Install it from: https://marketplace.visualstudio.com/items?itemName=humao.rest-client

@baseUrl = http://localhost:8000

# ==========================================================================
# /v1/sat/solve
# ==========================================================================

###
# @name sat_solve_satisfiable
# Solve a simple 3-variable SAT problem:
#   (x1 ∨ x2) ∧ (¬x1 ∨ x2) ∧ (x1 ∨ ¬x2)
# This formula is satisfiable (e.g. x1=T, x2=T).
POST {{baseUrl}}/v1/sat/solve
Content-Type: application/json

{
  "clauses": [[1, 2], [-1, 2], [1, -2]],
  "solver": "picosat"
}

###
# @name sat_solve_unsatisfiable
# Solve an unsatisfiable formula:
#   (x1) ∧ (¬x1)
POST {{baseUrl}}/v1/sat/solve
Content-Type: application/json

{
  "clauses": [[1], [-1]],
  "solver": "picosat"
}

###
# @name sat_solve_cryptominisat
# Use an alternative solver (CryptoMiniSat)
POST {{baseUrl}}/v1/sat/solve
Content-Type: application/json

{
  "clauses": [[1, 2], [-1, 2], [1, -2]],
  "solver": "cryptominisat"
}

###
# @name sat_solve_glucose
# Use Glucose solver
POST {{baseUrl}}/v1/sat/solve
Content-Type: application/json

{
  "clauses": [[1, 2], [-1, 2], [1, -2]],
  "solver": "glucose"
}

# ==========================================================================
# /v1/optimize/milp
# ==========================================================================

###
# @name optimize_milp_tutorial
# Simple MILP from the SageMath tutorial:
#   maximize 2·x + y   subject to  3·x + 4·y ≤ 2.5,  x ≥ 0, y ≥ 0
POST {{baseUrl}}/v1/optimize/milp
Content-Type: application/json

{
  "variables": ["x", "y"],
  "objective": {"x": 2, "y": 1},
  "maximize": true,
  "constraints": [
    {"coeffs": {"x": 3, "y": 4}, "max": 2.5}
  ],
  "var_types": {"x": "real", "y": "real"},
  "solver": "GLPK"
}

###
# @name optimize_milp_integer
# MILP with integer variables:
#   maximize x + y  subject to  x + 2·y ≤ 5,  3·x + y ≤ 6,  x,y ∈ ℤ⁺
POST {{baseUrl}}/v1/optimize/milp
Content-Type: application/json

{
  "variables": ["x", "y"],
  "objective": {"x": 1, "y": 1},
  "maximize": true,
  "constraints": [
    {"coeffs": {"x": 1, "y": 2}, "max": 5},
    {"coeffs": {"x": 3, "y": 1}, "max": 6}
  ],
  "var_types": {"x": "integer", "y": "integer"},
  "solver": "GLPK"
}

# ==========================================================================
# /v1/optimize/find-root
# ==========================================================================

###
# @name find_root_sin
# Find root of sin(x) = 0 in [3, 4]  →  x ≈ 3.14159 (π)
POST {{baseUrl}}/v1/optimize/find-root
Content-Type: application/json

{
  "expression": "sin(x)",
  "variable": "x",
  "a": 3,
  "b": 4
}

###
# @name find_root_quadratic
# Find root of x^2 - 4 = 0 in [0, 5]  →  x = 2
POST {{baseUrl}}/v1/optimize/find-root
Content-Type: application/json

{
  "expression": "x^2 - 4",
  "variable": "x",
  "a": 0,
  "b": 5
}

# ==========================================================================
# /v1/optimize/minimize
# ==========================================================================

###
# @name minimize_parabola
# Minimize f(x) = (x-3)^2 starting from x0=0  →  minimum at x=3
POST {{baseUrl}}/v1/optimize/minimize
Content-Type: application/json

{
  "expression": "(x - 3)^2",
  "variables": ["x"],
  "x0": [0]
}

# ==========================================================================
# /v1/maxima/evaluate
# ==========================================================================

###
# @name maxima_simplify
# Simplify the expression  (x + 1)^2 - (x^2 + 2x + 1)  →  0
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "(x + 1)^2 - (x^2 + 2*x + 1)",
  "operation": "simplify"
}

###
# @name maxima_differentiate
# Differentiate x^3 * sin(x) with respect to x
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "x^3 * sin(x)",
  "operation": "differentiate",
  "variable": "x"
}

###
# @name maxima_integrate
# Indefinite integral of x^2  →  x^3/3
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "x^2",
  "operation": "integrate",
  "variable": "x"
}

###
# @name maxima_integrate_definite
# Definite integral of x^2 from 0 to 1  →  1/3
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "x^2",
  "operation": "integrate",
  "variable": "x",
  "bounds": [0, 1]
}

###
# @name maxima_limit
# Limit of sin(x)/x as x → 0  →  1
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "sin(x)/x",
  "operation": "limit",
  "variable": "x"
}

###
# @name maxima_series
# Taylor series of sin(x) around x=0, order 5
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "sin(x)",
  "operation": "series",
  "variable": "x"
}

###
# @name maxima_laplace
# Laplace transform of t^2  →  2/s^3
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "t^2",
  "operation": "laplace",
  "variable": "t"
}

# ==========================================================================
# /v1/maxima/evaluate — Error cases
# ==========================================================================

###
# @name maxima_injection_attempt
# Attempt to inject a shell command (should be rejected)
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "system('rm -rf /')",
  "operation": "simplify"
}

###
# @name maxima_invalid_operation
# Unknown operation should be rejected as invalid payload
POST {{baseUrl}}/v1/maxima/evaluate
Content-Type: application/json

{
  "expression": "x^2",
  "operation": "do_harm"
}

# ==========================================================================
# General error cases
# ==========================================================================

###
# @name invalid_json
# Malformed JSON → 422 (FastAPI validation)
POST {{baseUrl}}/v1/sat/solve
Content-Type: application/json

{ invalid json here }

###
# @name unknown_route
# 404 — this endpoint does not exist
GET {{baseUrl}}/v1/nonexistent