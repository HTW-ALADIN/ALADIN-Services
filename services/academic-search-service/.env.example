# academic-search-service configuration.
#
# Intentionally does NOT contain any provider credentials (e.g. SCOPUS_API_KEY,
# OPENALEX_MAILTO): per the implementation plan, credentials are supplied
# per-request via the API body / CLI `--credentials` flag only, never through
# service-level environment variables.

HOST=0.0.0.0
PORT=8003
LOG_LEVEL=info

# HMAC signing key for citation-graph pagination cursors (core/pagination.py).
# MUST be set to a stable, secret value in any real deployment -- if unset,
# a random-per-process value is used, and cursors will stop validating across
# restarts/replicas.
GRAPH_CURSOR_SECRET=change-me-to-a-long-random-secret

# Bounds a single /v1/download call; larger batches must be paginated
# client-side across multiple calls.
DOWNLOAD_MAX_BATCH_SIZE=20
