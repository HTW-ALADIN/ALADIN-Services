# langgraph-service configuration.
#
# LLM credentials live in llm-gateway-service, not here: this service holds
# only the gateway connection details. Graph definitions are caller-supplied
# JSON (data only, never code).

HOST=0.0.0.0
PORT=8004
LOG_LEVEL=info

# Base URL of the llm-gateway-service OpenAI-compatible API used by `llm` nodes.
LLM_GATEWAY_BASE_URL=http://localhost:8002
# Bearer token for inference requests against the gateway (required for `llm`
# nodes; /health and non-LLM graphs still work without it).
LLM_GATEWAY_API_KEY=
# Per-node timeout for gateway calls, in seconds.
LLM_NODE_TIMEOUT_SECONDS=60
# Retry gateway calls once on 502/503/504 (default false).
LLM_RETRY_ONCE=false

# Per-node timeout for `http` tool calls, in seconds.
HTTP_NODE_TIMEOUT_SECONDS=30
HTTP_INTERNAL_HOST_ALLOWLIST=
# Cap on `http`-node response bodies, in bytes.
MAX_TOOL_RESPONSE_BYTES=1048576

# Checkpoint backend: memory (default, ephemeral) or postgres.
LANGGRAPH_CHECKPOINTER=memory
# Required when LANGGRAPH_CHECKPOINTER=postgres.
POSTGRES_URL=

# Per-run wall deadline, in seconds.
RUN_TIMEOUT_SECONDS=120
# Concurrent runs per process; excess runs are rejected with 503.
RUN_CONCURRENCY=4
# LangGraph recursion cap per run.
RECURSION_LIMIT=25

# Request-size guards, in bytes.
MAX_GRAPH_BYTES=65536
MAX_INPUT_BYTES=262144
MAX_OUTPUT_BYTES=1048576
