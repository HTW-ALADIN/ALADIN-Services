{
  "algorithm": "jaro_winkler",
  "params": {},
  "inputs": [
    { "id": "p1", "a": "MARTHA", "b": "MARHTA" }
  ]
}

### OSA (Optimal String Alignment)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "osa",
  "params": {},
  "inputs": [
    { "id": "p1", "a": "ca", "b": "abc" }
  ]
}

### Indel (LCS-based distance)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "indel",
  "params": {},
  "inputs": [
    { "id": "p1", "a": "kitten", "b": "sitting" }
  ]
}

### LCS extraction (textdistance)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "lcs",
  "params": {},
  "inputs": [
    { "id": "p1", "a": "kitten", "b": "sitting" }
  ]
}

### Needleman-Wunsch global alignment
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "needleman_wunsch",
  "params": { "gap_cost": 1.0 },
  "inputs": [
    { "id": "p1", "a": "kitten", "b": "sitting" }
  ]
}

### Smith-Waterman local alignment
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "smith_waterman",
  "params": {},
  "inputs": [
    { "id": "p1", "a": "kitten", "b": "sitting" }
  ]
}

### Token set similarity (Jaccard)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "token_set_similarity",
  "params": { "metric": "jaccard" },
  "inputs": [
    { "id": "p1", "a": "hello world", "b": "world hello" }
  ]
}

### Normalized Compression Distance (NCD)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "ncd",
  "params": { "qval": 1, "compressor": "zlib" },
  "inputs": [
    { "id": "p1", "a": "kitten", "b": "sitting" }
  ]
}

### Phonetic encoding (Soundex)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "phonetic_encoding",
  "params": { "scheme": "soundex" },
  "inputs": [
    { "id": "w1", "text": "Jellyfish" },
    { "id": "w2", "text": "Jelyfsh" }
  ]
}

### Long sequence alignment (edlib)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "long_sequence_alignment",
  "params": { "mode": "NW", "task": "distance" },
  "inputs": [
    { "id": "p1", "a": "kitten", "b": "sitting" }
  ]
}

### Diff/Patch (diff-match-patch)
POST http://localhost:8000/v1/text/compare
Content-Type: application/json

{
  "algorithm": "diff_patch",
  "params": {},
  "inputs": [
    { "id": "p1", "a": "The quick brown fox", "b": "The slow brown fox" }
  ]
}