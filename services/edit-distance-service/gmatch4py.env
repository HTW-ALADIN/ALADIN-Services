# Single source of truth for installing gmatch4py (the ged_hausdorff,
# ged_greedy, and gmatch4py-backend-of-ged_heuristic dependency).
#
# gmatch4py has no PyPI release, so it is installed directly from GitHub,
# pinned to a fixed commit for reproducibility (upstream has no
# tags/releases). Update this file only — the Makefile, Dockerfile, and CI
# workflow all read GMATCH4PY_REF/CYTHON_VERSION from here, so a version
# bump only needs to happen in one place.
#
# This file is sourced both as a shell script (`. ./gmatch4py.env` /
# `source gmatch4py.env`) and as a GNU Makefile fragment (`include
# gmatch4py.env`), so keep it restricted to simple `KEY=VALUE` lines with
# `#` comments only.
GMATCH4PY_REF=git+https://github.com/jacquesfize/GMatch4py.git@4fc0a822514c65c0d8b12d090b5b89c0af50ef2a
CYTHON_VERSION=3.2.9
