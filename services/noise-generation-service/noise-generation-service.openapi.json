        "responses": {
          "200": {
            "description": "List of algorithms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        }
      }
    },
    "/v1/noise": {
      "post": {
        "tags": [
          "crate"
        ],
        "operationId": "generate_noise",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateNoiseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Noise field created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoiseField"
                }
              }
            }
          }
        }
      }
    },
    "/v1/noise/{id}": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "get_noise_field",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Noise field ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Noise field data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "double"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Field not found"
          }
        }
      }
    },
    "/v1/noise/{id}/point": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "get_noise_point",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Noise field ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x",
            "in": "query",
            "description": "X coordinate",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "y",
            "in": "query",
            "description": "Y coordinate",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Noise point value",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "number",
                  "format": "double"
                }
              }
            }
          },
          "404": {
            "description": "Field not found"
          }
        }
      }
    }
  },
