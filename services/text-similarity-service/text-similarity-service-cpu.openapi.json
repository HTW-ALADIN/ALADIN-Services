{
  "openapi": "3.1.0",
  "info": {
    "title": "Text Similarity Service (cpu)",
    "description": "Unified REST API for semantic text similarity \u2014 16 algorithm families over multiple backends. Build variant: cpu. (PyTorch-based algorithms excluded)",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness: the process is up and serving.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "description": "Readiness: accepts requests now.\n\nThe service is synchronous and stateless; it reports ready as long as the\nprocess is up (the app is imported), which is the effective readiness signal\nfor compute. Cached-model/Memory and sidecar availability are intentionally\nNOT part of readiness, so the orchestrator never scales it away for a\ntransiently warm cache. Use ``GET /metrics`` for a live cache/uptime view.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "description": "Lightweight, dependency-free observability snapshot (JSON).\n\nFor a full metrics pipeline, scrape this with Prometheus/Datadog via an\nexporter or a gateway; this endpoint is intentionally dependency-free.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/similarity/text/algorithms": {
      "get": {
        "summary": "List Algorithms",
        "description": "Discovery: list all algorithm/backend combinations with metadata.",
        "operationId": "list_algorithms_v1_similarity_text_algorithms_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Algorithms V1 Similarity Text Algorithms Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/similarity/text/distance": {
      "post": {
        "summary": "Text Distance",
        "description": "Compute similarity scores for a batch of text pairs (synchronous).",
        "operationId": "text_distance_v1_similarity_text_distance_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextDistanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextComputeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/similarity/text/retrieval": {
      "post": {
        "summary": "Text Retrieval",
        "description": "Rank query candidates for a batch of retrieval queries (synchronous).",
        "operationId": "text_retrieval_v1_similarity_text_retrieval_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrievalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextComputeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/similarity/text/lexical": {
      "post": {
        "summary": "Text Lexical",
        "description": "Look up lexical relations for a batch of words (synchronous).",
        "operationId": "text_lexical_v1_similarity_text_lexical_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LexicalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextComputeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LexicalInput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "word": {
            "type": "string",
            "maxLength": 100000,
            "title": "Word"
          }
        },
        "type": "object",
        "required": [
          "id",
          "word"
        ],
        "title": "LexicalInput",
        "description": "One word for POST /v1/similarity/text/lexical."
      },
      "LexicalRequest": {
        "properties": {
          "algorithm": {
            "type": "string",
            "title": "Algorithm"
          },
          "backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backend"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/LexicalInput"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Inputs"
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "inputs"
        ],
        "title": "LexicalRequest",
        "description": "Request body for POST /v1/similarity/text/lexical."
      },
      "RetrievalInput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "query": {
            "type": "string",
            "maxLength": 100000,
            "title": "Query"
          },
          "candidates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Candidates"
          }
        },
        "type": "object",
        "required": [
          "id",
          "query",
          "candidates"
        ],
        "title": "RetrievalInput",
        "description": "One query + candidate list for POST /v1/similarity/text/retrieval."
      },
      "RetrievalRequest": {
        "properties": {
          "algorithm": {
            "type": "string",
            "title": "Algorithm"
          },
          "backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backend"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/RetrievalInput"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Inputs"
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "inputs"
        ],
        "title": "RetrievalRequest",
        "description": "Request body for POST /v1/similarity/text/retrieval."
      },
      "SimilarityInput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "a": {
            "type": "string",
            "maxLength": 100000,
            "title": "A"
          },
          "b": {
            "type": "string",
            "maxLength": 100000,
            "title": "B"
          }
        },
        "type": "object",
        "required": [
          "id",
          "a",
          "b"
        ],
        "title": "SimilarityInput",
        "description": "One text pair for POST /v1/similarity/text/distance."
      },
      "TextComputeResponse": {
        "properties": {
          "algorithm": {
            "type": "string",
            "title": "Algorithm"
          },
          "backend": {
            "type": "string",
            "title": "Backend"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/TextResult"
            },
            "type": "array",
            "title": "Results"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "backend",
          "results"
        ],
        "title": "TextComputeResponse",
        "description": "Response for every POST /v1/similarity/text/* endpoint."
      },
      "TextDistanceRequest": {
        "properties": {
          "algorithm": {
            "type": "string",
            "title": "Algorithm"
          },
          "backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backend"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/SimilarityInput"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Inputs"
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "inputs"
        ],
        "title": "TextDistanceRequest",
        "description": "Request body for POST /v1/similarity/text/distance."
      },
      "TextResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "result": {
            "additionalProperties": true,
            "type": "object",
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "TextResult",
        "description": "One computation result, keyed by the caller-supplied input id."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
